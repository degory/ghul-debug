{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "CommonJS",
        "rootDir": ".",
        "noEmit": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "types": [
            "node",
            "jest"
        ]
    },
    "include": [
        "src/**/*",
        "tests/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "out"
    ]
}
